<mvc:View controllerName="ui5.train.train.controller.train"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <List id="rtyu" class="" items="{path:'bookllist>/Book'}">
            <headerToolbar>
                <Toolbar>
                    <Title text="{i18n>TitleToolbar}"/>
                </Toolbar>
            </headerToolbar>
            <items>
                <StandardListItem
                    title="{bookllist>author}"
                    description="{bookllist>email}"
                    icon="{bookllist>picture}"
                    type="Active"
                    press=".onPress"/>
            </items>
        </List>
    </Page>
</mvc:View>