<mvc:View controllerName="trial1.trial1.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
		<VBox class="sapUiMediumMargin SpaceBetween">
			<Input placeholder="Enter new Todo" submit=".onAddTodo" value="{/newTodo}" />
			<Button text="Add" press="onAddTodo" class="sapUiSmallMarginTop"/>

			<List items="{/todos}">
				<CustomListItem >
					<HBox justifyContent="SpaceBetween">
						<Text text="{title}" class="{= ${completed} ? 'sapCriticalText' : '' }"/>
						<HBox >
							<Button text="Delete" press=".onDeleteTodo" type="Transparent"/>
							<Button text="Complete" press=".onCompleteTodo" type="Transparent"/>
						</HBox>
					</HBox>
				</CustomListItem>
			</List>

		</VBox>
    </Page>
</mvc:View>